# Server-side settings. Real values belong in ignored .env.local or hosting secrets.
# Модель: OPENAI_API_KEY (ChatGPT, основной провайдер) или GEMINI_API_KEY — см. integrations/llm.mjs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_REASONING_EFFORT=low
# Optional: LLM_PROVIDER=openai or gemini. Empty means choose an available key.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1024
